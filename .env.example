# Webex
WEBEX_WEBHOOK_SECRET=change-me-to-your-webhook-secret

# Webex Bot + Space -- BEIDE optional (s. bot_tokens.env für die echten Werte). Leer
# lassen, falls kein Webex-Messaging (Chats/Spaces) verfügbar ist -- dann wird nur
# noch die E-Mail-Benachrichtigung unten verschickt, kein Fehler.
WEBEX_BOT_TOKEN=change-me
WEBEX_BOT_EMAIL=change-me
WEBEX_SPACE_ID=change-me-roomId-der-Ziel-Space

# Optional: komma-getrennte Liste von Warteschlangen-Nummern (DNIS, internationales
# Format), auf die verpasste Anrufe eingeschränkt werden sollen.
# Leer = kein Filter, jeder nie beantwortete eingehende Anruf zählt (auch ohne
# Warteschlange). Die Nummer steht im echten telephony_calls-Event unter
# data.redirections[].redirectingParty.number, s. call_session_tracker.py.
WEBEX_TARGET_QUEUE_NUMBERS=

# Optional: E-Mail-Benachrichtigung bei verpasstem Anruf (zusätzlich zur Webex-
# Karte, falls konfiguriert), per Microsoft Graph -- Details s. email_client.py.
#
# GRAPH_CLIENT_SECRET LEER lassen -> Delegated Permission + Device Code Login,
# kein Admin-Consent nötig (für Accounts OHNE Admin-Rechte im Tenant). Nach dem
# Eintragen von GRAPH_CLIENT_ID/GRAPH_TENANT_ID einmalig ausführen:
#   .venv/Scripts/python.exe graph_device_login.py
#
# GRAPH_CLIENT_SECRET SETZEN -> Client Credentials (Application Permission),
# läuft unbeaufsichtigt ohne Ablaufrisiko, braucht aber einmaligen Admin-
# Consent + eine Exchange Application Access Policy.
#
# Leer/unvollständig konfiguriert = E-Mail-Versand wird übersprungen, kein Fehler.
GRAPH_CLIENT_ID=change-me
GRAPH_TENANT_ID=change-me
GRAPH_CLIENT_SECRET=
GRAPH_TOKEN_CACHE_PATH=graph_token_cache.json
# Absender-Postfach (Client Credentials) bzw. Anzeigewert (Device Code, s. config.py).
MAIL_FROM=change-me
# Empfänger-Postfach(-e) für die Benachrichtigung, komma-getrennt bei mehreren.
MAIL_TO=change-me

# Optional: mehrere Warteschlangen -> verschiedene Postfächer. Format
# "<queueNumber>=<mail1>,<mail2>;<queueNumber2>=<mail3>" (Semikolon trennt
# Warteschlangen, Komma trennt mehrere Empfänger pro Warteschlange). Leer =
# alles geht an MAIL_TO.
QUEUE_MAIL_ROUTES=
